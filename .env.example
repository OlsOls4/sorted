# ---- PayPal (optional) ----
# Without these the app runs in DEMO MODE with a mock PayPal backend.
# Users can also paste their own SANDBOX Client ID + Secret in the app
# ("Connect PayPal sandbox"); those are kept in their browser and take precedence.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox
# Optional override, e.g. https://api-m.sandbox.paypal.com
# PAYPAL_API_BASE=
# Set to 1 to ignore server PayPal creds and force demo mode
# SORTED_FORCE_DEMO=

# ---- AI (optional, first one found wins unless SORTED_AI_PROVIDER is set) ----
# Without a key, Sorted uses its deterministic rules engine for everything.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint (Groq, OpenRouter, Ollama...)
# OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# gemini | openai | anthropic
# SORTED_AI_PROVIDER=
# SORTED_AI_TIMEOUT_MS=25000
# Set to 1 to force the rules engine even if a key is present
# SORTED_AI_DISABLED=

# ---- Dev only ----
# Set to 1 when an egress proxy injects PayPal Basic auth for you: the OAuth
# token request is then sent with no Authorization header. Sandbox only and
# ignored on Vercel. PAYPAL_CLIENT_ID/SECRET may be left blank in this mode.
# (Node needs NODE_USE_ENV_PROXY=1 to route fetch through an HTTPS_PROXY.)
# PAYPAL_AUTH_VIA_PROXY=
