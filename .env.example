# ---- PayPal (optional) ----
# Without these the app runs in DEMO MODE with a mock PayPal backend.
# Users can also paste their own SANDBOX Client ID + Secret in the app
# ("Connect PayPal sandbox"); those are kept in their browser and take precedence.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox
# Optional override, e.g. https://api-m.sandbox.paypal.com
# PAYPAL_API_BASE=
# Set to 1 to ignore server PayPal creds and force demo mode
# SORTED_FORCE_DEMO=

# ---- AI (optional; free tiers first) ----
# Every configured provider is tried in this order, falling through on
# 429 / 5xx / timeout: Groq -> NVIDIA NIM -> OpenRouter -> Gemini -> OpenAI -> Anthropic.
# A 429 parks that provider+model for a few minutes (in memory). With no key, or
# when every provider is busy, Sorted uses its deterministic rules engine.
# Groq (free tier, https://console.groq.com/keys). Free limits are per model per org,
# so Sorted defaults to gpt-oss-20b and tries the fallback model on a 429.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b   (set to "none" to disable)
# NVIDIA NIM (free credits, https://build.nvidia.com)
NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# OpenRouter (free ":free" models, https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Google Gemini (free tier is small: ~20 requests/day on some keys)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Any other OpenAI-compatible endpoint (Ollama, Together...)
# OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# Pin exactly one provider: groq | nvidia | openrouter | gemini | openai | anthropic
# SORTED_AI_PROVIDER=
# Per-call timeout and total time budget across providers (ms)
# SORTED_AI_TIMEOUT_MS=12000
# SORTED_AI_BUDGET_MS=25000
# Set to 1 to force the rules engine even if a key is present
# SORTED_AI_DISABLED=

# ---- Dev only ----
# Set to 1 when an egress proxy injects PayPal Basic auth for you: the OAuth
# token request is then sent with no Authorization header. Sandbox only and
# ignored on Vercel. PAYPAL_CLIENT_ID/SECRET may be left blank in this mode.
# (Node needs NODE_USE_ENV_PROXY=1 to route fetch through an HTTPS_PROXY.)
# PAYPAL_AUTH_VIA_PROXY=
